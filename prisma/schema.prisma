generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AiProvider {
  OPENAI
  GEMINI
}

enum Platform {
  LINKEDIN
  INSTAGRAM
}

enum VisualType {
  GENERATED
}

model User {
  id                       String    @id
  onboardingCompletedAt    DateTime?
  writingExamplesSkippedAt DateTime?
  visualStylePreferences   Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  aiCredentials   AiCredential[]
  writingExamples WritingExample[]
  posts           Post[]
  visuals         Visual[]

  @@index([onboardingCompletedAt])
}

model AiCredential {
  id              String     @id @default(cuid())
  userId          String
  provider        AiProvider
  encryptedApiKey String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model WritingExample {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  platform  Platform
  idea      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  visuals Visual[]

  @@index([userId])
  @@index([userId, platform])
}

model Visual {
  id          String     @id @default(cuid())
  userId      String
  postId      String?
  type        VisualType
  storageKey  String
  mimeType    String
  prompt      String?
  aspectRatio String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
}
